{
  "name": "minilab",
  "version": "0.3.0",
  "description": "MiniLab - persistent AI research lab: hire persistent AI researchers, push research with tasks/memory/artifacts/meetings, PI dashboard included",
  "main": "dist/electron/main.js",
  "bin": {
    "minilab": "bin/minilab.js"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md",
    "LICENSE",
    "docs",
    "start.bat",
    "test.bat"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "dev": "node --watch dist/src/server.js",
    "test": "npm run build && node --test dist/tests/",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepublishOnly": "npm run build && npm test",
    "build:exe": "npm run build && pkg . --output dist-exe/MiniLab.exe",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win nsis",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:restore": "npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "research",
    "lab",
    "agents",
    "sqlite",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JkL-06/minilab.git"
  },
  "homepage": "https://jkl-06.github.io/minilab/",
  "bugs": {
    "url": "https://github.com/JkL-06/minilab/issues"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@yao-pkg/pkg": "6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist-exe"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
